{
    "plugin": {
        "name": "Edge essentials",
        "description": "On-device document parsing, PDF page rendering, audio and first/last-frame extraction, video concat / mute / audio merge (Mediabunny + WebCodecs, ffmpeg.wasm for formats the browser cannot read), language detection, knowledge-base chunking and embedding (bge, granite-embedding r2, harrier on WebGPU), and audio models (transcription with SenseVoice, X-ASR, Qwen3-ASR or Zipformer-CTC and, on WebGPU, Whisper large-v3-turbo or Cohere Transcribe; speech segmentation; speaker diarization with pyannote + CAM++ or Nemotron-3-Diarization; audio event tagging) and small vision/document models (OCR with PP-OCRv6, page orientation, layout, tables, shot splitting, object detection) in the browser, plus optional WebGPU nodes: image understanding (Qwen3.5-0.8B), GLM-OCR, image embeddings (EmbeddingGemma 2) and key-point extraction (LFM2.5-350M). Alternative implementations to pick per node: YOLO26n and RF-DETR nano (objects), PP-DocLayoutV3 (layout), LFM2.5-VL-450M, SmolVLM2 and Florence-2 (image understanding), Chinese-CLIP (image embeddings), PDFium, pdf2md, officeparser and Readability (document parsing). Files never leave the device."
    },
    "runtime": "browser",
    "entry": "dist/index.js",
    "slots": [
        { "nodeSlot": "parse-document", "method": "parseDocument", "models": ["builtin", "pdfium", "pdf2md", "officeparser", "readability", "mupdf"] },
        { "nodeSlot": "render-pages", "method": "renderPages", "models": ["pdfjs", "mupdf"] },
        { "nodeSlot": "extract-audio", "method": "extractAudio", "models": ["mediabunny", "ffmpeg-wasm"] },
        { "nodeSlot": "get-first-frame", "method": "getFirstFrame", "models": ["mediabunny", "ffmpeg-wasm"] },
        { "nodeSlot": "get-last-frame", "method": "getLastFrame", "models": ["mediabunny", "ffmpeg-wasm"] },
        { "nodeSlot": "concat-videos", "method": "concatVideos", "models": ["mediabunny", "ffmpeg-wasm"] },
        { "nodeSlot": "remove-video-audio", "method": "removeVideoAudio", "models": ["mediabunny", "ffmpeg-wasm"] },
        { "nodeSlot": "merge-video-audio", "method": "mergeVideoAudio", "models": ["mediabunny", "ffmpeg-wasm"] },
        { "nodeSlot": "detect-language", "method": "detectLanguage" },
        { "nodeSlot": "chunk-text", "method": "chunkText" },
        { "nodeSlot": "embed-text", "method": "embedText", "models": ["bge-small-zh-v1.5", "bge-base-zh-v1.5", "harrier-oss-v1-270m", "granite-embedding-97m-multilingual-r2"] },
        { "nodeSlot": "kb-write", "method": "kbWrite" },
        { "nodeSlot": "image-gen-text", "method": "imageGenText", "models": ["qwen3.5-0.8b", "lfm2.5-vl-450m", "smolvlm2-500m", "florence-2-base"] },
        { "nodeSlot": "image-describe", "method": "imageGenText", "models": ["qwen3.5-0.8b", "lfm2.5-vl-450m", "smolvlm2-500m", "florence-2-base"] },
        { "nodeSlot": "embed-image", "method": "embedImage", "models": ["embeddinggemma-2", "chinese-clip-base"] },
        { "nodeSlot": "gen-text", "method": "genText", "models": ["lfm2.5-350m", "qwen3.5-0.8b-text"] },
        { "nodeSlot": "ocr-image", "method": "ocrImage", "models": ["pp-ocrv6-small", "pp-ocrv6-tiny", "glm-ocr"] },
        { "nodeSlot": "transcribe", "method": "transcribe", "models": ["sensevoice-small", "sensevoice-small+ffmpeg-wasm", "x-asr-zh-en", "x-asr-zh-en+ffmpeg-wasm", "whisper-large-v3-turbo", "whisper-large-v3-turbo+ffmpeg-wasm", "cohere-transcribe-03-2026", "cohere-transcribe-03-2026+ffmpeg-wasm", "qwen3-asr-0.6b", "qwen3-asr-0.6b+ffmpeg-wasm", "zipformer-ctc-small-zh", "zipformer-ctc-small-zh+ffmpeg-wasm"] },
        { "nodeSlot": "transcribe-timestamp", "method": "transcribeTimestamp", "models": ["sensevoice-small", "sensevoice-small+ffmpeg-wasm", "x-asr-zh-en", "x-asr-zh-en+ffmpeg-wasm", "whisper-large-v3-turbo", "whisper-large-v3-turbo+ffmpeg-wasm", "zipformer-ctc-small-zh", "zipformer-ctc-small-zh+ffmpeg-wasm"] },
        { "nodeSlot": "vad-segment", "method": "vadSegment", "models": ["silero-vad-v5", "silero-vad-v5+ffmpeg-wasm"] },
        { "nodeSlot": "diarize-speakers", "method": "diarizeSpeakers", "models": ["pyannote-campplus-zh", "pyannote-campplus-zh+ffmpeg-wasm", "nemotron-3-diarization", "nemotron-3-diarization+ffmpeg-wasm"] },
        { "nodeSlot": "audio-tag", "method": "audioTag", "models": ["ced-tiny", "ced-tiny+ffmpeg-wasm"] },
        { "nodeSlot": "image-orient", "method": "imageOrient", "models": ["pp-lcnet-doc-ori"] },
        { "nodeSlot": "layout-detect", "method": "layoutDetect", "models": ["pp-doclayout-s", "pp-doclayout-m", "pp-doclayoutv3"] },
        { "nodeSlot": "table-recognize", "method": "tableRecognize", "models": ["slanet-plus"] },
        { "nodeSlot": "split-video", "method": "splitVideo", "models": ["transnetv2", "transnetv2+ffmpeg-wasm"] },
        { "nodeSlot": "detect-objects", "method": "detectObjects", "models": ["dfine-nano-fp16", "dfine-nano", "yolo26n", "rf-detr-nano"] }
    ]
}
