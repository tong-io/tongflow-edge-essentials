{
    "plugin": {
        "name": "Edge essentials",
        "description": "On-device document parsing, PDF page rendering, audio/first-frame extraction, language detection, and knowledge-base chunking and embedding in the browser. Files never leave the device."
    },
    "runtime": "browser",
    "entry": "dist/index.js",
    "slots": [
        { "nodeSlot": "parse-document", "method": "parseDocument" },
        { "nodeSlot": "render-pages", "method": "renderPages" },
        { "nodeSlot": "extract-audio", "method": "extractAudio" },
        { "nodeSlot": "get-first-frame", "method": "getFirstFrame" },
        { "nodeSlot": "detect-language", "method": "detectLanguage" },
        { "nodeSlot": "chunk-text", "method": "chunkText" },
        { "nodeSlot": "embed-text", "method": "embedText", "models": ["bge-small-zh-v1.5", "bge-base-zh-v1.5"] },
        { "nodeSlot": "kb-write", "method": "kbWrite" }
    ]
}
